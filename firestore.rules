rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Regla abierta para facilitar el desarrollo (sin fecha de expiración). 
      // Más adelante, cuando la app esté lista, se puede restringir para que 
      // solo el profesor (autenticado) y los estudiantes de la sesión puedan escribir.
      allow read, write: if true;
    }
  }
}
